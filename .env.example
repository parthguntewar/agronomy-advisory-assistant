# ==============================================================================
# Agronomy Advisory Assistant Environment Configuration
# Copy this file to .env and configure your desired settings:
#   cp .env.example .env
#
# DO NOT commit .env containing real API keys or sensitive credentials.
# ==============================================================================

# LLM Provider Selection
# Options:
#   mock   - Deterministic offline generator (no external calls, ideal for tests)
#   ollama - Local Ollama runtime (100% private, runs on Windows laptop)
#   api    - Cloud API (OpenAI-compatible endpoints: OpenAI, Groq, Together, etc.)
LLM_PROVIDER=mock

# ------------------------------------------------------------------------------
# Ollama Configuration (for LLM_PROVIDER=ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# Cloud API Configuration (for LLM_PROVIDER=api)
# ------------------------------------------------------------------------------
# Set your actual API key here. NEVER commit your actual key to git.
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30.0
